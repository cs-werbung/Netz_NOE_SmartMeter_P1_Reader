# Copy to .env and fill in:  cp .env.example .env
# .env contains your key and MQTT password - do not commit it.

# --- Serial interface ------------------------------------------------------
# USB-M-Bus adapter on the P1 customer interface (RJ12)
PORT=/dev/ttyUSB0
# Netz NÖ specification: fixed 2400 baud
BAUD=2400

# --- Decryption ------------------------------------------------------------
# 32 hex digits (16 bytes), request from smartmeter@netz-noe.at
# or in the Netz NÖ Smart Meter web portal
KEY=00000000000000000000000000000000

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR   (log file: /var/log/decrypter.log)
LOGLEVEL=WARNING

# --- MQTT ------------------------------------------------------------------
MQTT_HOST=192.168.1.10
# empty = 1883, or 8883 if MQTT_TLS=true
MQTT_PORT=
# leave empty if the broker allows anonymous access
MQTT_USER=mqttuser
MQTT_PASS=mqttpassword
MQTT_TOPIC=/home/smartmeter/vals
# true: broker keeps the last valid value, Home Assistant gets it after a restart
MQTT_RETAIN=true

# --- MQTT TLS (optional) ---------------------------------------------------
MQTT_TLS=false
# CA certificate of the broker; empty = system CA store
MQTT_TLS_CA=
# client certificate + key, only if the broker requires client certificates
MQTT_TLS_CERT=
MQTT_TLS_KEY=
# true = do not check the host name in the certificate (still encrypted),
# e.g. when connecting by IP to a broker whose certificate is issued for a name
MQTT_TLS_INSECURE=false
